---
export interface Props {
  name: string;
  tagline: string;
  platform: string;
  icon: string;
  slug: string;
  features: string[];
  category: string;
  downloadUrl?: string;
  index?: number;
}

const { name, tagline, platform, icon, slug, features, category, downloadUrl, index = 0 } = Astro.props;

const categoryColors: Record<string, string> = {
  'developer-tools': '#99F6E4',
  'finance': '#6EE7B7',
  'lifestyle': '#FCD34D',
};

const accentColor = categoryColors[category] || '#99F6E4';
---

<a href={`/apps/${slug}`} class={`card animate-fade-in animate-delay-${index + 1}`} style={`--accent: ${accentColor}`}>
  <div class="card-border"></div>
  <div class="card-content">
    <div class="card-header">
      <span class="card-icon">{icon}</span>
      <span class="card-platform">{platform}</span>
    </div>

    <h3 class="card-title">{name}</h3>
    <p class="card-tagline">{tagline}</p>

    <ul class="card-features">
      {features.slice(0, 3).map((f) => (
        <li>{f}</li>
      ))}
    </ul>

    <div class="card-footer">
      <span class="card-cta">Learn more →</span>
    </div>
  </div>
</a>

<script>
  // Add interactive mouse tracking to cards
  const cards = document.querySelectorAll('.card');
  cards.forEach((card) => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      (card as HTMLElement).style.setProperty('--mouse-x', `${x}px`);
      (card as HTMLElement).style.setProperty('--mouse-y', `${y}px`);
    });
  });
</script>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border-radius: var(--radius-lg);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.04), var(--shadow-card);
    cursor: pointer;
    position: relative;
    opacity: 0;
    text-decoration: none;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transition: transform var(--transition);
  }

  /* The interactive glow inside the card */
  .card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: inherit;
    background: radial-gradient(
      800px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(255, 255, 255, 0.04),
      transparent 40%
    );
    opacity: 0;
    transition: opacity 0.5s;
    z-index: 1;
    pointer-events: none;
  }

  /* The interactive border glow */
  .card-border {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: inherit;
    padding: 1px;
    background: var(--border-card);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    z-index: 0;
  }

  .card-border::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(
      400px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      var(--accent),
      transparent 40%
    );
    opacity: 0;
    transition: opacity 0.5s;
  }

  .card:hover::before,
  .card:hover .card-border::before {
    opacity: 1;
  }

  .card-content {
    padding: 2rem;
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    border-radius: inherit;
    background: rgba(9, 14, 17, 0.46);
    transition: background var(--transition), transform var(--transition);
  }

  .card:hover .card-content {
    background: var(--bg-card-hover);
    transform: translateY(-2px);
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .card-icon {
    font-size: 2.25rem;
    line-height: 1;
    filter: drop-shadow(0 4px 12px rgba(255,255,255,0.1));
  }

  .card-platform {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--border-subtle);
    border-radius: 100px;
    background: var(--surface-muted);
  }

  .card-title {
    font-size: 1.375rem;
    font-weight: 700;
    margin-bottom: 0.375rem;
    letter-spacing: -0.02em;
  }

  .card-tagline {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    line-height: 1.5;
  }

  .card-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .card-features li {
    font-size: 0.8rem;
    color: var(--text-muted);
    padding-left: 1.25rem;
    position: relative;
  }

  .card-features li::before {
    content: '✦';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-size: 0.6rem;
    top: 0.15em;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .card-cta {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    transition: color var(--transition), letter-spacing var(--transition);
  }

  .card:hover .card-cta {
    letter-spacing: 0.02em;
  }
</style>
