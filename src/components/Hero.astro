<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 85vh;
    padding: 4rem 2rem;
    text-align: center;
    overflow: hidden;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 700px;
  }

  .hero-avatar {
    margin-bottom: 2rem;
    display: flex;
    justify-content: center;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .avatar-circle {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: var(--bg-secondary);
    color: var(--text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    font-weight: 800;
    position: relative;
    z-index: 2;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 2px 20px rgba(0,0,0,0.5);
    letter-spacing: -0.02em;
  }

  .avatar-glow {
    position: absolute;
    inset: -12px;
    border-radius: 50%;
    background: var(--gradient-hero);
    z-index: 1;
    filter: blur(20px);
    opacity: 0.4;
    animation: breathe 5s infinite alternate ease-in-out;
  }

  @keyframes breathe {
    0% { transform: scale(0.95); opacity: 0.3; }
    100% { transform: scale(1.05); opacity: 0.5; }
  }

  .hero-badge {
    display: inline-block;
    padding: 0.375rem 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-teal);
    border: 1px solid rgba(20, 184, 166, 0.3);
    border-radius: 100px;
    background: rgba(20, 184, 166, 0.08);
    margin-bottom: 1.5rem;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.05s forwards;
    opacity: 0;
  }

  .hero-title {
    font-size: clamp(3.5rem, 8vw, 6rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.05em;
    margin-bottom: 1.5rem;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
    opacity: 0;
  }

  .hero-line {
    display: block;
    color: var(--text-primary);
  }

  .hero-gradient {
    display: block;
    background: var(--gradient-hero);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    background-size: 200% auto;
    animation: shimmer 5s linear infinite;
  }

  @keyframes shimmer {
    to { background-position: 200% center; }
  }

  .hero-subtitle {
    font-size: 1.2rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 540px;
    margin: 0 auto 2.5rem;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
    opacity: 0;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 3rem;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
    opacity: 0;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: all var(--transition);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .btn:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .btn-primary {
    background: var(--gradient-hero);
    border: none;
    color: #fff;
    font-weight: 700;
  }

  .btn-primary:hover {
    box-shadow: 0 8px 32px rgba(20, 184, 166, 0.35);
    transform: translateY(-2px);
    background: var(--gradient-hero);
  }

  .hero-scroll {
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.5s forwards, bounce 2.5s ease-in-out 1.2s infinite;
    opacity: 0;
    font-size: 1.25rem;
    color: var(--text-muted);
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(8px); }
  }

  /* Animated Mesh Gradient Glow */
  .hero-glow {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
  }

  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    animation: float 20s infinite ease-in-out alternate;
    opacity: 0.5;
  }

  .orb-1 {
    top: 10%;
    left: 20%;
    width: 500px;
    height: 500px;
    background: rgba(20, 184, 166, 0.15);
    animation-delay: 0s;
  }

  .orb-2 {
    bottom: -10%;
    right: 10%;
    width: 600px;
    height: 600px;
    background: rgba(16, 185, 129, 0.12);
    animation-delay: -5s;
    animation-direction: alternate-reverse;
  }

  .orb-3 {
    top: 40%;
    left: 60%;
    width: 400px;
    height: 400px;
    background: rgba(59, 130, 246, 0.1);
    animation-delay: -10s;
  }

  @keyframes float {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-5%, 5%) scale(1.1); }
    100% { transform: translate(5%, -5%) scale(0.9); }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 75vh;
      padding: 3rem 1.5rem;
    }

    .hero-subtitle {
      font-size: 1.05rem;
    }
    
    .hero-actions {
      flex-direction: column;
      align-items: center;
    }

    .btn {
      width: 100%;
      max-width: 280px;
      justify-content: center;
    }

    .glow-orb {
      filter: blur(60px);
    }
  }
</style>

