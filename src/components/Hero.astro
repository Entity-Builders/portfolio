---

---

<section class="hero">
  <div class="hero-content">
    <div class="hero-badge">Entity Builders Studio</div>
    <h1 class="hero-title">
      <span class="hero-gradient">Entity Builders</span>
    </h1>
    <p class="hero-subtitle">
      We build, organize, and manage the digital entity for diverse operations.<br/>
      From robust B2B systems to standalone creative experiences.
    </p>
    <div class="hero-actions">
      <a href="/maker" class="btn">Meet the Builder</a>
    </div>
    <div class="hero-scroll">
      <span>↓</span>
    </div>
  </div>
  
  <div class="hero-glow">
    <div class="glow-orb orb-1"></div>
    <div class="glow-orb orb-2"></div>
    <div class="glow-orb orb-3"></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 70vh;
    padding: 4rem 2rem;
    text-align: center;
    overflow: hidden;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 640px;
  }

  .hero-badge {
    display: inline-block;
    padding: 0.375rem 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-emerald);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: 100px;
    background: rgba(16, 185, 129, 0.08);
    margin-bottom: 1.5rem;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hero-title {
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.04em;
    margin-bottom: 1.25rem;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
    opacity: 0;
  }

  .hero-gradient {
    background: var(--gradient-hero);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    background-size: 200% auto;
    animation: shimmer 5s linear infinite;
  }

  @keyframes shimmer {
    to { background-position: 200% center; }
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 520px;
    margin: 0 auto 2.5rem;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
    opacity: 0;
  }

  .hero-actions {
    margin-bottom: 3rem;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
    opacity: 0;
  }

  .btn {
    display: inline-block;
    padding: 0.875rem 2rem;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 600;
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all var(--transition);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .btn:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--accent-teal);
    box-shadow: 0 8px 32px rgba(20, 184, 166, 0.25);
    transform: translateY(-2px);
  }

  .hero-scroll {
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.5s forwards, bounce 2.5s ease-in-out 1.2s infinite;
    opacity: 0;
    font-size: 1.25rem;
    color: var(--text-muted);
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(8px); }
  }

  /* Animated Mesh Gradient Glow */
  .hero-glow {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
  }

  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    animation: float 20s infinite ease-in-out alternate;
    opacity: 0.5;
  }

  .orb-1 {
    top: 10%;
    left: 20%;
    width: 500px;
    height: 500px;
    background: rgba(20, 184, 166, 0.15); /* Teal */
    animation-delay: 0s;
  }

  .orb-2 {
    bottom: -10%;
    right: 10%;
    width: 600px;
    height: 600px;
    background: rgba(16, 185, 129, 0.12); /* Emerald */
    animation-delay: -5s;
    animation-direction: alternate-reverse;
  }

  .orb-3 {
    top: 40%;
    left: 60%;
    width: 400px;
    height: 400px;
    background: rgba(59, 130, 246, 0.1); /* Blue */
    animation-delay: -10s;
  }

  @keyframes float {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-5%, 5%) scale(1.1); }
    100% { transform: translate(5%, -5%) scale(0.9); }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 60vh;
      padding: 3rem 1.5rem;
    }

    .hero-subtitle {
      font-size: 1.1rem;
    }
    
    .glow-orb {
      filter: blur(60px);
    }
  }
</style>

