<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(85vh - 64px);
    padding: 4rem 2rem;
    text-align: center;
    overflow: hidden;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 760px;
    min-width: 0;
  }

  .hero-avatar {
    margin-bottom: 2rem;
    display: flex;
    justify-content: center;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .avatar-circle {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: var(--bg-elevated);
    color: var(--text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    font-weight: 800;
    position: relative;
    z-index: 2;
    border: 1px solid var(--border-card);
    box-shadow: inset 0 2px 20px rgba(0,0,0,0.5);
    letter-spacing: 0;
  }

  .avatar-glow {
    position: absolute;
    inset: -12px;
    border-radius: 50%;
    background: var(--gradient-signature);
    z-index: 1;
    filter: blur(20px);
    opacity: 0.2;
    animation: breathe 5s infinite alternate ease-in-out;
  }

  @keyframes breathe {
    0% { transform: scale(0.96); opacity: 0.16; }
    100% { transform: scale(1.04); opacity: 0.26; }
  }

  .hero-badge {
    display: inline-block;
    max-width: 100%;
    padding: 0.375rem 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-teal-soft);
    border: 1px solid var(--accent-border);
    border-radius: 100px;
    background: var(--accent-surface);
    margin-bottom: 1.5rem;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.05s forwards;
    opacity: 0;
    white-space: normal;
  }

  .hero-title {
    font-size: clamp(3.5rem, 8vw, 6rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0;
    margin-bottom: 1.5rem;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
    opacity: 0;
  }

  .hero-line {
    display: block;
    color: var(--text-primary);
  }

  .hero-gradient {
    display: block;
    background: var(--gradient-signature);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    background-size: 200% auto;
    animation: shimmer 5s linear infinite;
  }

  @keyframes shimmer {
    to { background-position: 200% center; }
  }

  .hero-subtitle {
    font-size: 1.2rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 650px;
    margin: 0 auto 1.1rem;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
    opacity: 0;
    overflow-wrap: break-word;
  }

  .hero-proof {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.45rem;
    max-width: 720px;
    margin: 0 auto 2.4rem;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.24s forwards;
    opacity: 0;
  }

  .hero-proof span {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0.34rem 0.72rem;
    border-radius: 999px;
    border: 1px solid var(--border-subtle);
    background: rgba(255, 255, 255, 0.028);
    color: var(--text-secondary);
    font-size: 0.74rem;
    font-weight: 800;
    line-height: 1.35;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 3rem;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
    opacity: 0;
  }

  .hero-secondary-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin: -1.75rem 0 3rem;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.38s forwards;
    opacity: 0;
  }

  .hero-secondary-actions a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text-muted);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .hero-secondary-actions a:hover {
    color: var(--accent-teal);
    transform: translateY(-1px);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 100px;
    background: var(--surface-muted);
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    border: 1px solid var(--border-card);
    transition:
      transform var(--transition),
      background var(--transition),
      border-color var(--transition),
      box-shadow var(--transition);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .btn:hover {
    background: var(--surface-muted-hover);
    border-color: var(--border-card-hover);
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .btn-primary {
    background: var(--gradient-hero);
    border: none;
    color: var(--text-on-accent);
    font-weight: 700;
  }

  .btn-primary:hover {
    box-shadow: 0 10px 30px rgba(45, 212, 191, 0.18);
    transform: translateY(-2px);
    background: var(--gradient-hero);
  }

  .hero-scroll {
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.5s forwards, bounce 2.5s ease-in-out 1.2s infinite;
    opacity: 0;
    font-size: 1.25rem;
    color: var(--text-muted);
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(8px); }
  }

  /* Animated Mesh Gradient Glow */
  .hero-glow {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
  }

  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    animation: float 20s infinite ease-in-out alternate;
    opacity: 0.34;
  }

  .orb-1 {
    top: 10%;
    left: 20%;
    width: 500px;
    height: 500px;
    background: rgba(45, 212, 191, 0.1);
    animation-delay: 0s;
  }

  .orb-2 {
    bottom: -10%;
    right: 10%;
    width: 600px;
    height: 600px;
    background: rgba(214, 168, 86, 0.06);
    animation-delay: -5s;
    animation-direction: alternate-reverse;
  }

  .orb-3 {
    top: 40%;
    left: 60%;
    width: 400px;
    height: 400px;
    background: rgba(96, 165, 250, 0.07);
    animation-delay: -10s;
  }

  @keyframes float {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-5%, 5%) scale(1.1); }
    100% { transform: translate(5%, -5%) scale(0.9); }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: auto;
      padding: 2.25rem 1.25rem 2.35rem;
    }

    .hero-avatar {
      margin-bottom: 1.25rem;
    }

    .avatar-circle {
      width: 84px;
      height: 84px;
      font-size: 1.7rem;
    }

    .hero-badge {
      font-size: 0.68rem;
      letter-spacing: 0.05em;
      margin-bottom: 1rem;
    }

    .hero-title {
      font-size: clamp(3rem, 15vw, 4rem);
      margin-bottom: 1rem;
    }

    .hero-subtitle {
      font-size: 0.98rem;
      line-height: 1.62;
      margin-bottom: 0.85rem;
    }

    .hero-proof {
      gap: 0.35rem;
      margin-bottom: 1.5rem;
    }

    .hero-proof span {
      min-height: 28px;
      padding: 0.28rem 0.56rem;
      font-size: 0.64rem;
    }
    
    .hero-actions {
      flex-direction: column;
      align-items: center;
      margin-bottom: 2.05rem;
    }

    .hero-secondary-actions {
      margin-top: -1rem;
      margin-bottom: 2rem;
    }

    .btn {
      width: 100%;
      max-width: 280px;
      justify-content: center;
    }

    .glow-orb {
      filter: blur(60px);
    }
  }
</style>
