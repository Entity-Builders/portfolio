---
// ChatWidget.astro — Floating AI chat bubble
// Uses the portfolio-chat Supabase Edge Function
const configuredSupabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || '';
const configuredSupabaseAnonKey =
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
const isLocalSupabaseUrl = /^https?:\/\/(localhost|127\.0\.0\.1)(?::|\/|$)/.test(
  configuredSupabaseUrl
);
const assistantSupabaseUrl =
  import.meta.env.PROD && isLocalSupabaseUrl ? '' : configuredSupabaseUrl;
const assistantSupabaseAnonKey = assistantSupabaseUrl
  ? configuredSupabaseAnonKey
  : '';
const assistantIsConfigured = Boolean(
  assistantSupabaseUrl && assistantSupabaseAnonKey
);
const publicAssistantSupabaseUrl = assistantIsConfigured
  ? assistantSupabaseUrl
  : '';
const publicAssistantSupabaseAnonKey = assistantIsConfigured
  ? assistantSupabaseAnonKey
  : '';
---

{assistantIsConfigured && (
  <div id="chat-widget">
    <!-- Floating Bubble -->
    <button id="chat-toggle" aria-label="Chat with AI assistant">
      <svg id="chat-icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
      </svg>
      <svg id="chat-icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
      <span class="chat-badge" id="chat-badge">AI</span>
    </button>

    <!-- Chat Window -->
    <div id="chat-window" class="chat-hidden">
      <div class="chat-header">
        <div class="chat-header-info">
          <div class="chat-avatar">JO</div>
          <div>
            <strong>Product Engineering Assistant</strong>
            <span class="chat-status">Juan's work, systems, and fit</span>
          </div>
        </div>
      </div>

      <div id="chat-messages" class="chat-messages">
        <div class="chat-msg assistant">
          <p>Hey! Ask me about Juan's case studies, product engineering work, AI/mobile systems, or collaboration fit.</p>
        </div>
      </div>

      <form id="chat-form" class="chat-input-area">
        <input
          type="text"
          id="chat-input"
          name="portfolio-question"
          placeholder="Ask about case studies…"
          maxlength="500"
          autocomplete="off"
        />
        <button type="submit" id="chat-send" aria-label="Send message">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
        </button>
      </form>
    </div>
  </div>
)}

<style>
  /* ── Chat Widget Globals ── */
  #chat-widget {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 9999;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
  }

  /* ── Toggle Button ── */
  #chat-toggle {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 1px solid var(--accent-border);
    background: linear-gradient(135deg, rgba(45, 212, 191, 0.1), rgba(17, 24, 29, 0.9));
    color: var(--accent-teal);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4), 0 0 24px rgba(45, 212, 191, 0.08);
    transition:
      transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      border-color 0.3s ease,
      box-shadow 0.3s ease,
      background 0.3s ease;
    position: relative;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  #chat-toggle:hover {
    transform: scale(1.04);
    box-shadow: 0 6px 32px rgba(0, 0, 0, 0.5), 0 0 34px rgba(45, 212, 191, 0.14);
    border-color: var(--accent-border-strong);
  }

  .chat-badge {
    position: absolute;
    top: -4px;
    right: -4px;
    font-size: 0.55rem;
    font-weight: 800;
    background: var(--accent-teal);
    color: var(--text-on-accent);
    padding: 2px 5px;
    border-radius: 100px;
    letter-spacing: 0.05em;
  }

  /* ── Chat Window ── */
  #chat-window {
    position: absolute;
    bottom: 72px;
    right: 0;
    width: 380px;
    max-height: 520px;
    border-radius: 16px;
    border: 1px solid var(--border-card);
    background: rgba(9, 14, 17, 0.96);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    box-shadow: 0 8px 48px rgba(0, 0, 0, 0.62), 0 0 1px rgba(255, 255, 255, 0.1);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition:
      opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: bottom right;
  }

  #chat-window.chat-hidden {
    opacity: 0;
    transform: scale(0.9) translateY(10px);
    pointer-events: none;
  }

  /* ── Header ── */
  .chat-header {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
    background: rgba(255, 255, 255, 0.018);
  }

  .chat-header-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .chat-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--gradient-hero);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--text-on-accent);
    flex-shrink: 0;
  }

  .chat-header-info strong {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .chat-status {
    font-size: 0.7rem;
    color: var(--accent-teal);
    font-weight: 500;
  }

  /* ── Messages ── */
  .chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-height: 300px;
    max-height: 360px;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.1) transparent;
  }

  .chat-msg {
    max-width: 85%;
    padding: 0.75rem 1rem;
    border-radius: 12px;
    font-size: 0.85rem;
    line-height: 1.5;
    animation: chatFadeIn 0.3s ease;
  }

  .chat-msg p {
    margin: 0;
  }

  .chat-msg.assistant {
    align-self: flex-start;
    background: var(--surface-muted);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  .chat-msg.user {
    align-self: flex-end;
    background: linear-gradient(135deg, rgba(45, 212, 191, 0.14), rgba(45, 212, 191, 0.06));
    border: 1px solid var(--accent-border);
    color: var(--text-primary);
  }

  .chat-msg.typing {
    align-self: flex-start;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.04);
    color: var(--text-muted);
    font-style: italic;
  }

  @keyframes chatFadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ── Input ── */
  .chat-input-area {
    display: flex;
    gap: 0.5rem;
    padding: 0.875rem 1.25rem;
    border-top: 1px solid var(--border-subtle);
    background: rgba(255, 255, 255, 0.018);
  }

  #chat-input {
    flex: 1;
    background: var(--surface-muted);
    border: 1px solid var(--border-card);
    border-radius: 100px;
    padding: 0.6rem 1rem;
    color: var(--text-primary);
    font-size: 0.85rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s ease;
  }

  #chat-input::placeholder {
    color: var(--text-muted);
  }

  #chat-input:focus {
    border-color: var(--accent-border-strong);
  }

  #chat-input:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }

  #chat-send {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: none;
    background: var(--accent-teal);
    color: var(--text-on-accent);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }

  #chat-send:hover {
    background: var(--accent-teal-strong);
    transform: scale(1.05);
  }

  #chat-send:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    transform: none;
  }

  /* ── Mobile ── */
  @media (max-width: 480px) {
    #chat-window {
      width: calc(100vw - 2rem);
      right: -0.5rem;
      max-height: 70vh;
    }
  }
</style>

<script
  is:inline
  define:vars={{
    supabaseUrl: publicAssistantSupabaseUrl,
    supabaseAnonKey: publicAssistantSupabaseAnonKey,
  }}
>
  (function() {
    const EDGE_URL = supabaseUrl ? supabaseUrl + '/functions/v1/portfolio-chat' : '';
    const supabaseKeyIsJwt = supabaseAnonKey && supabaseAnonKey.startsWith('eyJ');
    const EDGE_HEADERS = {
      'Content-Type': 'application/json',
      ...(supabaseAnonKey
        ? {
            apikey: supabaseAnonKey,
          }
        : {}),
      ...(supabaseKeyIsJwt
        ? {
            Authorization: 'Bearer ' + supabaseAnonKey,
          }
        : {}),
    };

    const toggle = document.getElementById('chat-toggle');
    const chatWindow = document.getElementById('chat-window');
    const iconOpen = document.getElementById('chat-icon-open');
    const iconClose = document.getElementById('chat-icon-close');
    const badge = document.getElementById('chat-badge');
    const form = document.getElementById('chat-form');
    const input = document.getElementById('chat-input');
    const messages = document.getElementById('chat-messages');
    const sendBtn = document.getElementById('chat-send');

    if (!toggle || !chatWindow || !iconOpen || !iconClose || !badge || !form || !input || !messages || !sendBtn) {
      return;
    }

    let isOpen = false;
    let history = [];
    let isLoading = false;
    let hadRecoverableError = false;

    toggle.addEventListener('click', () => {
      isOpen = !isOpen;
      chatWindow.classList.toggle('chat-hidden', !isOpen);
      iconOpen.style.display = isOpen ? 'none' : 'block';
      iconClose.style.display = isOpen ? 'block' : 'none';
      badge.style.display = isOpen ? 'none' : 'block';
      if (isOpen) input.focus();
      trackAssistant(isOpen ? 'assistant_open' : 'assistant_close', {
        action: isOpen ? 'open' : 'close',
        assistant_outcome: 'toggle',
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const text = input.value.trim();
      if (!text || isLoading) return;
      const question_topic = classifyQuestionTopic(text);
      const message_length_bucket = messageLengthBucket(text);

      if (hadRecoverableError) {
        trackAssistant('assistant_retry', {
          action: 'retry',
          question_topic,
          message_length_bucket,
          assistant_outcome: 'retry_after_error',
        });
      }

      trackAssistant('assistant_submit', {
        action: 'submit',
        question_topic,
        message_length_bucket,
        assistant_outcome: 'submitted',
      });

      // Add user message
      addMessage(text, 'user');
      history.push({ role: 'user', content: text });
      input.value = '';
      isLoading = true;
      sendBtn.disabled = true;

      // Show typing indicator
      const typingEl = addMessage('Thinking…', 'typing');

      if (!EDGE_URL) {
        typingEl.remove();
        addMessage('Assistant is not configured yet. Try again later.', 'assistant');
        trackAssistant('assistant_unavailable', {
          action: 'error',
          question_topic,
          message_length_bucket,
          assistant_outcome: 'missing_edge_url',
        });
        hadRecoverableError = true;
        isLoading = false;
        sendBtn.disabled = false;
        input.focus();
        return;
      }

      try {
        const res = await fetch(EDGE_URL, {
          method: 'POST',
          headers: EDGE_HEADERS,
          body: JSON.stringify({
            history: history.slice(-10),
            message: text,
            source: {
              ...getSourceMetadata(),
              surface: 'assistant',
              question_topic,
              message_length_bucket,
            },
          }),
        });

        const data = await res.json();
        typingEl.remove();

        const reply = data.response || data.error || 'Something went wrong.';
        addMessage(reply, 'assistant');
        history.push({ role: 'assistant', content: reply });
        trackAssistant(res.ok ? 'assistant_response' : 'assistant_error', {
          action: res.ok ? 'response' : 'error',
          question_topic,
          message_length_bucket,
          assistant_outcome: res.status === 429 ? 'rate_limited' : res.ok ? 'answered' : 'endpoint_error',
        });
        hadRecoverableError = !res.ok;
      } catch (err) {
        typingEl.remove();
        addMessage('Connection error. Try again later.', 'assistant');
        trackAssistant('assistant_error', {
          action: 'error',
          question_topic,
          message_length_bucket,
          assistant_outcome: 'network_error',
        });
        hadRecoverableError = true;
      }

      isLoading = false;
      sendBtn.disabled = false;
      input.focus();
    });

    function addMessage(text, role) {
      const div = document.createElement('div');
      div.className = `chat-msg ${role}`;
      div.innerHTML = `<p>${escapeHtml(text)}</p>`;
      messages.appendChild(div);
      messages.scrollTop = messages.scrollHeight;
      return div;
    }

    function escapeHtml(str) {
      const d = document.createElement('div');
      d.textContent = str;
      return d.innerHTML;
    }

    function trackAssistant(event, properties) {
      window.portfolioAnalytics?.trackAssistant?.(event, properties);
    }

    function classifyQuestionTopic(text) {
      return window.portfolioAnalytics?.classifyQuestionTopic?.(text) || 'unknown';
    }

    function messageLengthBucket(text) {
      return window.portfolioAnalytics?.messageLengthBucket?.(text) || 'unknown';
    }

    function getSourceMetadata() {
      return (
        window.portfolioAnalytics?.getSourceMetadata?.() || {
          route: window.location.pathname,
          page_type: document.body?.dataset.pageType || 'unknown',
          slug: document.body?.dataset.pageSlug || undefined,
        }
      );
    }
  })();
</script>
