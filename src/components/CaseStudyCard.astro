---
import type { CaseStudy } from '../data/caseStudies';

export interface Props {
  study: CaseStudy;
  featured?: boolean;
}

const { study, featured = false } = Astro.props;
---

<a
  href={`/case-studies/${study.slug}`}
  class:list={['case-card', { featured }]}
  data-analytics-surface="case_study_card"
  data-analytics-destination="case_study"
>
  <div class="case-top">
    <span class="case-eyebrow">{study.eyebrow}</span>
    <span class="case-status">{study.status}</span>
  </div>
  <h3>{study.title}</h3>
  {study.outcome && (
    <p class="case-outcome">
      <span>Outcome</span>
      {study.outcome}
    </p>
  )}
  <p class="case-thesis">{study.thesis}</p>
  <div class="case-domains">
    {study.domains.slice(0, 4).map((domain) => (
      <span>{domain}</span>
    ))}
  </div>
  <div class="case-evidence">
    {study.evidence.slice(0, 3).map((item) => (
      <span>{item}</span>
    ))}
  </div>
  <span class="case-link">Read case study -></span>
</a>

<style>
  .case-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    min-height: 100%;
    padding: 1.65rem;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-lg);
    color: inherit;
    text-decoration: none;
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.04), var(--shadow-card);
    transition:
      transform var(--transition),
      border-color var(--transition),
      background var(--transition),
      box-shadow var(--transition);
  }

  .case-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--gradient-hero);
    opacity: 0;
    transition: opacity var(--transition);
  }

  .case-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-card-hover);
    background: var(--bg-card-hover);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.08), var(--shadow-card-hover);
  }

  .case-card:hover::before {
    opacity: 1;
  }

  .case-card.featured {
    background: linear-gradient(160deg, rgba(45, 212, 191, 0.045), rgba(18, 24, 29, 0.62), rgba(214, 168, 86, 0.035));
  }

  .case-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .case-eyebrow,
  .case-status {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.4;
  }

  .case-eyebrow {
    color: var(--accent-teal-soft);
  }

  .case-status {
    color: var(--text-muted);
    text-align: right;
  }

  h3 {
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    overflow-wrap: break-word;
  }

  .case-outcome {
    display: grid;
    gap: 0.35rem;
    padding: 0.75rem 0.85rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--accent-border);
    background: linear-gradient(135deg, rgba(45, 212, 191, 0.085), rgba(96, 165, 250, 0.035));
    color: var(--text-primary);
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .case-outcome span {
    color: var(--accent-teal-soft);
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }

  .case-thesis {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.6;
    flex: 1;
  }

  .case-domains,
  .case-evidence {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .case-domains span,
  .case-evidence span {
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .case-domains span {
    padding: 0.25rem 0.6rem;
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
    background: var(--surface-muted);
  }

  .case-evidence span {
    padding: 0.25rem 0.55rem;
    color: var(--accent-teal-soft);
    border: 1px solid var(--accent-border);
    background: var(--accent-surface);
  }

  .case-link {
    color: var(--accent-teal);
    font-size: 0.82rem;
    font-weight: 800;
    margin-top: 0.25rem;
  }

  @media (max-width: 640px) {
    .case-card {
      padding: 1.35rem;
    }

    .case-top {
      flex-direction: column;
      gap: 0.35rem;
    }

    .case-status {
      text-align: left;
    }
  }
</style>
