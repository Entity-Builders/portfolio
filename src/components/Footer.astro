<footer class="footer">
  <div class="footer-inner">
    <p class="footer-brand">
      <span class="footer-logo">⚡</span> Juan Obrach
    </p>
    <p class="footer-copy">
      &copy; {new Date().getFullYear()} Juan Manuel Obrach. Built with Astro.
    </p>
    <div class="footer-links">
      <a href="/about" class="footer-link">About</a>
      <span class="footer-sep">·</span>
      <a href="/blog" class="footer-link">Writing</a>
      <span class="footer-sep">·</span>
      <a href="https://linkedin.com/in/jmobrach" target="_blank" rel="noopener noreferrer" class="footer-link">LinkedIn</a>
      <span class="footer-sep">·</span>
      <a href="https://github.com/juanobrach" target="_blank" rel="noopener noreferrer" class="footer-link">GitHub</a>
      <span class="footer-sep">·</span>
      <a href="mailto:juanobrach@gmail.com" class="footer-link">Contact</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-subtle);
    padding: 2.5rem 2rem;
    text-align: center;
    margin-top: 4rem;
  }

  .footer-inner {
    max-width: 960px;
    margin: 0 auto;
  }

  .footer-brand {
    font-size: 0.9rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .footer-logo {
    font-size: 1rem;
  }

  .footer-copy {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .footer-links {
    margin-top: 1rem;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-sep {
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .footer-link {
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-link:hover {
    color: var(--accent-teal);
  }
</style>
