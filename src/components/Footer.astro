---

---

<footer class="footer">
  <div class="footer-inner">
    <p class="footer-brand">
      <span class="footer-logo">⚡</span> Entity Builders
    </p>
    <p class="footer-copy">
      &copy; {new Date().getFullYear()} Entity Builders. Built with craft.
    </p>
    <div class="footer-links">
      <a href="/maker" class="footer-link">Meet the Builder</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-subtle);
    padding: 2.5rem 2rem;
    text-align: center;
    margin-top: 4rem;
  }

  .footer-inner {
    max-width: 960px;
    margin: 0 auto;
  }

  .footer-brand {
    font-size: 0.9rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .footer-logo {
    font-size: 1rem;
  }

  .footer-copy {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .footer-links {
    margin-top: 1rem;
  }

  .footer-link {
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-link:hover {
    color: var(--text-primary);
  }
</style>
