---
import type { CaseStudy } from '../data/caseStudies';

export interface Props {
  study: CaseStudy;
  nextStudy?: CaseStudy;
}

const { study, nextStudy } = Astro.props;
---

<article class="case-detail">
  <header class="case-hero">
    <a href="/case-studies" class="case-back">← All case studies</a>
    <div class="case-eyebrow">{study.eyebrow}</div>
    <h1>{study.title}</h1>
    <p class="case-thesis">{study.thesis}</p>
    <div class="case-meta">
      <span>{study.timeframe}</span>
      <span>{study.status}</span>
      {study.domains.map((domain) => <span>{domain}</span>)}
    </div>
  </header>

  <section class="case-summary">
    <div>
      <span class="section-kicker">Context</span>
      <p>{study.context}</p>
    </div>
    <div class="evidence-panel">
      <span class="section-kicker">Evidence</span>
      <ul>
        {study.evidence.map((item) => <li>{item}</li>)}
      </ul>
      {study.artifact && (
        <a href={study.artifact.href} class="artifact-link">
          {study.artifact.label} ->
        </a>
      )}
    </div>
  </section>

  <div class="case-body">
    <section class="case-section">
      <span class="section-kicker">Problem</span>
      <p>{study.problem}</p>
    </section>

    <section class="case-section">
      <span class="section-kicker">Product Decisions</span>
      <ul class="rich-list">
        {study.decisions.map((decision) => <li>{decision}</li>)}
      </ul>
    </section>

    <section class="case-section">
      <span class="section-kicker">Technical System</span>
      <div class="system-grid">
        {study.system.map((group) => (
          <div class="system-card">
            <h2>{group.label}</h2>
            <ul>
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="case-section">
      <span class="section-kicker">Tradeoffs</span>
      <ul class="rich-list">
        {study.tradeoffs.map((tradeoff) => <li>{tradeoff}</li>)}
      </ul>
    </section>

    <section class="case-section">
      <span class="section-kicker">Role</span>
      <p>{study.role}</p>
    </section>

    <section class="case-section proves-section">
      <span class="section-kicker">What This Proves</span>
      <ul class="proof-grid">
        {study.proves.map((proof) => <li>{proof}</li>)}
      </ul>
    </section>
  </div>

  <footer class="case-footer-actions">
    <a href="/case-studies" class="case-action secondary">All case studies</a>
    {nextStudy && (
      <a href={`/case-studies/${nextStudy.slug}`} class="case-action">
        Next: {nextStudy.title}
      </a>
    )}
    <a href="mailto:juanobrach@gmail.com" class="case-action">Start a conversation</a>
  </footer>
</article>

<style>
  .case-detail {
    position: relative;
    z-index: 1;
    max-width: 960px;
    margin: 0 auto;
    padding: 4rem 2rem 2rem;
  }

  .case-hero {
    max-width: 780px;
    margin-bottom: 2.5rem;
  }

  .case-back {
    display: inline-flex;
    margin-bottom: 2.25rem;
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .case-back:hover {
    color: var(--accent-teal);
  }

  .case-eyebrow,
  .section-kicker {
    display: block;
    color: var(--accent-teal);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  h1 {
    font-size: clamp(2.25rem, 6vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.05em;
    font-weight: 900;
    margin-bottom: 1.2rem;
    color: var(--text-primary);
    overflow-wrap: break-word;
  }

  .case-thesis {
    color: var(--text-secondary);
    font-size: clamp(1.05rem, 2.2vw, 1.35rem);
    line-height: 1.65;
    max-width: 720px;
  }

  .case-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1.5rem;
  }

  .case-meta span {
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
    background: rgba(255, 255, 255, 0.04);
    border-radius: 999px;
    padding: 0.35rem 0.75rem;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .case-summary {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(260px, 0.7fr);
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .case-summary > div,
  .case-section,
  .system-card {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-lg);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.04), var(--shadow-card);
  }

  .case-summary > div {
    padding: 1.75rem;
  }

  .case-summary p,
  .case-section p,
  .rich-list li,
  .system-card li,
  .proof-grid li {
    color: var(--text-secondary);
    line-height: 1.75;
    font-size: 0.98rem;
  }

  .evidence-panel ul,
  .rich-list,
  .system-card ul,
  .proof-grid {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .evidence-panel li,
  .rich-list li,
  .system-card li,
  .proof-grid li {
    position: relative;
    padding-left: 1.3rem;
  }

  .evidence-panel li::before,
  .rich-list li::before,
  .system-card li::before,
  .proof-grid li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--accent-teal);
  }

  .artifact-link {
    display: inline-flex;
    margin-top: 1rem;
    color: var(--accent-teal);
    font-size: 0.86rem;
    font-weight: 800;
  }

  .case-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .case-section {
    padding: 2rem;
  }

  .system-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .system-card {
    padding: 1.35rem;
    background: rgba(255, 255, 255, 0.03);
  }

  .system-card h2 {
    color: var(--text-primary);
    font-size: 1rem;
    line-height: 1.3;
    margin-bottom: 0.85rem;
  }

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .case-footer-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin: 2rem 0 0;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
  }

  .case-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.75rem 1.1rem;
    border-radius: 999px;
    color: #fff;
    background: var(--gradient-hero);
    font-size: 0.86rem;
    font-weight: 800;
    text-decoration: none;
  }

  .case-action.secondary {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-primary);
    border: 1px solid var(--border-card);
  }

  @media (max-width: 820px) {
    .case-summary,
    .system-grid,
    .proof-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .case-detail {
      padding: 2.75rem 1.25rem 1rem;
    }

    .case-summary > div,
    .case-section {
      padding: 1.35rem;
    }

    .case-footer-actions {
      flex-direction: column;
    }

    .case-action {
      width: 100%;
    }
  }
</style>
