---
import ChatWidget from '../components/ChatWidget.astro';
import SiteNav from '../components/SiteNav.astro';

export interface Props {
  title: string;
  description?: string;
  date?: Date;
  tags?: string[];
}

const {
  title,
  description = 'Technical articles about React Native, Expo, monorepos, and building Micro-SaaS.',
  date,
  tags = [],
} = Astro.props;

const ogImage = new URL('/og-image.png', Astro.site).href;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const cloudflareAnalyticsToken = import.meta.env.PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN;
const formattedDate = date
  ? new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' }).format(date)
  : null;

// Estimate reading time (avg 200 wpm)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Juan Manuel Obrach" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Juan Obrach" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content="@juan_obrach" />

    <link rel="canonical" href={canonicalURL} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — Juan Obrach</title>

    {cloudflareAnalyticsToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cloudflareAnalyticsToken })}
      />
    )}
  </head>
  <body>
    <SiteNav />
    <div class="blog-chrome">
      <!-- Top nav bar -->
      <nav class="blog-nav">
        <a href="/" class="nav-home">
          <span class="nav-logo">⚡</span>
          <span>Juan Obrach</span>
        </a>
        <a href="/blog" class="nav-back">
          ← All articles
        </a>
      </nav>

      <!-- Article shell -->
      <article class="article-wrapper">
        <header class="article-header">
          {tags.length > 0 && (
            <div class="article-tags">
              {tags.map((tag) => (
                <span class="tag-chip">{tag}</span>
              ))}
            </div>
          )}
          <h1 class="article-title">{title}</h1>
          {description && <p class="article-desc">{description}</p>}
          {formattedDate && (
            <div class="article-meta">
              <time class="article-date">{formattedDate}</time>
            </div>
          )}
        </header>

        <div class="prose">
          <slot />
        </div>

        <footer class="article-footer">
          <div class="footer-divider"></div>
          <div class="footer-actions">
            <a href="/blog" class="back-link">← Back to all articles</a>
            <a href="/" class="home-link">juanobrach.dev ↗</a>
          </div>
        </footer>
      </article>
    </div>

    <ChatWidget />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  .blog-chrome {
    min-height: 100vh;
    position: relative;
    z-index: 1;
  }

  /* ── Navigation ── */
  .blog-nav {
    position: static;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 2rem;
    background: rgba(10, 15, 18, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .nav-home {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-home:hover { color: var(--accent-teal); }

  .nav-logo { font-size: 1rem; }

  .nav-back {
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-back:hover { color: var(--accent-teal); }

  /* ── Article wrapper ── */
  .article-wrapper {
    max-width: 740px;
    margin: 0 auto;
    padding: 3rem 2rem 5rem;
  }

  /* ── Article Header ── */
  .article-header {
    margin-bottom: 3rem;
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }

  .tag-chip {
    font-size: 0.68rem;
    font-weight: 600;
    padding: 0.25rem 0.65rem;
    background: rgba(20, 184, 166, 0.08);
    border: 1px solid rgba(20, 184, 166, 0.2);
    border-radius: 100px;
    color: var(--accent-teal);
    text-transform: lowercase;
    letter-spacing: 0.02em;
  }

  .article-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, var(--text-primary) 60%, var(--accent-teal));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .article-desc {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 1.25rem;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .article-date {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  /* ── Prose Content ── */
  .prose {
    animation: fadeInUp 0.7s 0.1s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /* ── Article Footer ── */
  .article-footer {
    margin-top: 4rem;
  }

  .footer-divider {
    height: 1px;
    background: var(--border-subtle);
    margin-bottom: 2rem;
  }

  .footer-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .back-link,
  .home-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-link:hover,
  .home-link:hover {
    color: var(--accent-teal);
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .blog-nav { padding: 0.875rem 1.25rem; }
    .article-wrapper { padding: 2rem 1.25rem 4rem; }
    .footer-actions { flex-direction: column; gap: 1rem; align-items: flex-start; }
  }
</style>
