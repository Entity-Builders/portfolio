---
import ChatWidget from '../components/ChatWidget.astro';
import SiteNav from '../components/SiteNav.astro';
import AnalyticsScripts from '../components/AnalyticsScripts.astro';
import type { JsonLd } from '../lib/seo';

export interface Props {
  title: string;
  description?: string;
  pageType?:
    | 'home'
    | 'about'
    | 'case_studies_index'
    | 'case_study'
    | 'writing_index'
    | 'article'
    | 'app_detail'
    | 'unknown';
  slug?: string;
  structuredData?: JsonLd | JsonLd[];
}

const {
  title,
  description = 'Senior Product Engineer turning ambiguous product ideas into shipped mobile, AI, and web systems.',
  pageType = 'unknown',
  slug,
  structuredData = [],
} = Astro.props;
const ogImage = new URL('/og-image.png', Astro.site).href;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const cloudflareAnalyticsToken = import.meta.env.PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN;
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const portfolioChatEnabled =
  import.meta.env.PUBLIC_PORTFOLIO_CHAT_ENABLED === 'true';
const jsonLdItems = Array.isArray(structuredData)
  ? structuredData
  : [structuredData];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Juan Manuel Obrach" />
    <meta name="theme-color" content="#090E11" />
    {googleSiteVerification && (
      <meta name="google-site-verification" content={googleSiteVerification} />
    )}
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Juan Obrach" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content="@juan_obrach" />
    
    <link rel="canonical" href={canonicalURL} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    {jsonLdItems.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}

    {cloudflareAnalyticsToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cloudflareAnalyticsToken })}
      />
    )}
    <AnalyticsScripts title={title} pageType={pageType} slug={slug} />
  </head>
  <body data-page-type={pageType} data-page-slug={slug}>
    <SiteNav />
    <slot />
    {portfolioChatEnabled && <ChatWidget />}
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
