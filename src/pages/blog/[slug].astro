---
import { getCollection, type CollectionEntry } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'blog'> };

const { post } = Astro.props;
const { Content } = await post.render();
---

<BlogLayout
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  tags={post.data.tags}
>
  <Content />
</BlogLayout>

<!-- Mermaid diagrams — loaded client-side so Astro static build stays simple -->
<script type="module">
  import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';

  mermaid.initialize({
    startOnLoad: false,
    theme: 'base',
    themeVariables: {
      fontFamily: 'Plus Jakarta Sans, sans-serif',
      primaryColor: '#11181D',
      primaryTextColor: '#F7FAFC',
      primaryBorderColor: '#2DD4BF',
      lineColor: '#7E8DA0',
      secondaryColor: '#11181D',
      tertiaryColor: '#090E11',
      background: '#090E11',
      mainBkg: '#11181D',
      nodeBorder: 'rgba(45,212,191,0.28)',
      clusterBkg: '#11181D',
      titleColor: '#F7FAFC',
      edgeLabelBackground: '#090E11',
      attributeBackgroundColorEven: '#11181D',
      attributeBackgroundColorOdd: '#0d1117',
      actorBkg: '#11181D',
      actorBorder: '#2DD4BF',
      actorTextColor: '#F7FAFC',
      signalColor: '#A8B5C3',
      signalTextColor: '#F7FAFC',
      noteBkgColor: '#172026',
      noteTextColor: '#F7FAFC',
      noteBorderColor: 'rgba(45,212,191,0.34)',
    },
    flowchart: { curve: 'basis', padding: 24 },
    sequence: { actorMargin: 64, messageMargin: 44, mirrorActors: false },
  });

  document.querySelectorAll('pre[data-language="mermaid"]').forEach((pre) => {
    const div = document.createElement('div');
    div.className = 'mermaid';
    div.textContent = pre.textContent?.trim() ?? '';
    pre.replaceWith(div);
  });

  await mermaid.run({ querySelector: '.mermaid' });
</script>
