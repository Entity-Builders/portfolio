---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import { featuredCaseStudies } from '../data/caseStudies';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout
  title="Juan Obrach - Senior Product Engineer"
  description="Senior Product Engineer focused on React Native, AI systems, and end-to-end product execution. Built in scale-up teams and through independent product work."
  pageType="home"
>
  <main>
    <Hero />

    <nav class="mobile-quick-actions" aria-label="Portfolio quick actions" data-analytics-surface="mobile_quick_actions">
      <a href="/case-studies">Case studies</a>
      <a href="/CV_Juan_Obrach.pdf" download>CV</a>
      <a href="mailto:juanobrach@gmail.com">Contact</a>
    </nav>

    <!-- Compact Experience Bar -->
    <section class="experience-bar" data-analytics-surface="experience_bar">
      <div class="exp-track">
        <a href="https://www.rbi.com" target="_blank" rel="noopener noreferrer" class="exp-chip">
          <span class="exp-emoji">🍔</span>
          <div>
            <strong>Restaurant Brands Intl.</strong>
            <span>Scale-up mobile · 2022-Present</span>
          </div>
        </a>
        <a href="https://blockfi.com" target="_blank" rel="noopener noreferrer" class="exp-chip">
          <span class="exp-emoji">₿</span>
          <div>
            <strong>BlockFi</strong>
            <span>Trading UX · 2021-2022</span>
          </div>
        </a>
        <div class="exp-chip">
          <span class="exp-emoji">💬</span>
          <div>
            <strong>Yelly App</strong>
            <span>React Native · 2020-2021</span>
          </div>
        </div>
        <div class="exp-chip">
          <span class="exp-emoji">🏢</span>
          <div>
            <strong>MRM / McCann</strong>
            <span>Full stack · 2017-2020</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Case Studies -->
    <section class="featured" data-analytics-surface="featured_case_studies">
      <h2 class="featured-title">Featured Case Studies</h2>
      <p class="featured-sub">Evidence for technical leaders: product judgment, systems, tradeoffs, and shipped work.</p>

      <div class="case-grid-home">
        {featuredCaseStudies.map((study, index) => (
          <CaseStudyCard study={study} featured={index === 0} />
        ))}
      </div>

      <div class="more-projects">
        <a href="/case-studies" class="more-link">View all case studies -></a>
      </div>
    </section>

    <!-- Latest Writing -->
    <section class="writing-section" data-analytics-surface="latest_writing">
      <div class="writing-header">
        <div>
          <h2 class="writing-title">Latest Writing</h2>
          <p class="writing-sub">Technical notes from building products, fixing systems, and working in the open.</p>
        </div>
        <a href="/blog" class="writing-all">All articles →</a>
      </div>

      <div class="writing-grid">
        {latestPosts.map((post) => {
          const date = new Intl.DateTimeFormat('en-US', {
            year: 'numeric', month: 'short', day: 'numeric'
          }).format(post.data.date);
          return (
            <a href={`/blog/${post.slug}`} class="writing-card">
              <div class="writing-card-top">
                <time class="writing-date">{date}</time>
                <div class="writing-tags">
                  {post.data.tags.slice(0, 2).map((tag) => (
                    <span class="writing-tag">{tag}</span>
                  ))}
                </div>
              </div>
              <h3 class="writing-card-title">{post.data.title}</h3>
              {post.data.description && (
                <p class="writing-card-desc">{post.data.description}</p>
              )}
              <span class="writing-read">Read →</span>
            </a>
          );
        })}
      </div>
    </section>

    <Footer />
  </main>
</Layout>

<style>
  main {
    position: relative;
    z-index: 1;
  }

  /* ── Experience Bar ── */
  .mobile-quick-actions {
    display: none;
  }

  .mobile-quick-actions a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.68rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--border-card);
    background: var(--surface-muted);
    color: var(--text-primary);
    font-size: 0.78rem;
    font-weight: 800;
    line-height: 1.2;
    text-decoration: none;
    transition:
      transform var(--transition),
      border-color var(--transition),
      background var(--transition);
  }

  .mobile-quick-actions a:first-child {
    border-color: var(--accent-border);
    background: var(--accent-surface);
    color: var(--accent-teal-soft);
  }

  .mobile-quick-actions a:hover {
    transform: translateY(-1px);
    border-color: var(--border-card-hover);
    background: var(--surface-muted-hover);
  }

  .experience-bar {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 2rem 3rem;
    position: relative;
  }

  .experience-bar::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 60px;
    background: linear-gradient(to right, transparent, var(--bg-primary, #0a0f14));
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  @media (max-width: 768px) {
    .experience-bar::after {
      opacity: 1;
    }
  }

  .exp-track {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 0.5rem;
  }

  .exp-track::-webkit-scrollbar { display: none; }

  .exp-chip {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: 100px;
    white-space: nowrap;
    flex-shrink: 0;
    text-decoration: none;
    color: inherit;
    transition:
      transform var(--transition),
      border-color var(--transition),
      background var(--transition),
      box-shadow var(--transition);
  }

  .exp-chip:hover {
    border-color: var(--border-card-hover);
    background: var(--bg-card-hover);
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover);
  }

  .exp-emoji {
    font-size: 1.25rem;
  }

  .exp-chip strong {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .exp-chip span:not(.exp-emoji) {
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  /* ── Featured Projects ── */
  .featured {
    max-width: 1080px;
    margin: 0 auto;
    padding: 2rem 2rem 3rem;
    text-align: center;
  }

  .featured-title {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.4rem;
  }

  .featured-sub {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
  }

  .case-grid-home {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    text-align: left;
  }

  .case-grid-home :global(.case-card:first-child) {
    grid-row: auto;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    text-align: left;
  }

  .project-card {
    padding: 2rem;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-lg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition:
      transform var(--transition),
      border-color var(--transition),
      background var(--transition),
      box-shadow var(--transition);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.04), var(--shadow-card);
    position: relative;
    overflow: hidden;
  }

  .project-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--gradient-hero);
    opacity: 0;
    transition: opacity var(--transition);
  }

  .project-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-card-hover);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.08), var(--shadow-card-hover);
  }

  .project-card:hover::before {
    opacity: 1;
  }

  /* First card spans full width */
  .project-highlight {
    grid-column: span 2;
    background: linear-gradient(160deg, rgba(45, 212, 191, 0.045), rgba(18, 24, 29, 0.56), rgba(214, 168, 86, 0.035));
  }

  .project-badge {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .project-card h3 {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .project-card p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    flex: 1;
  }

  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .project-stack span {
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.25rem 0.6rem;
    background: var(--surface-muted);
    border: 1px solid var(--border-subtle);
    border-radius: 100px;
    color: var(--text-muted);
  }

  .project-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-teal);
    margin-top: 0.25rem;
  }

  .more-projects {
    margin-top: 2rem;
  }

  .more-link {
    font-size: 0.9rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .more-link:hover {
    color: var(--accent-teal);
  }

  /* ── Responsive ── */
  @media (max-width: 980px) {
    .case-grid-home {
      grid-template-columns: 1fr;
    }

    .case-grid-home :global(.case-card:first-child) {
      grid-row: span 1;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }

    .project-highlight {
      grid-column: span 1;
    }
  }

  @media (max-width: 640px) {
    .mobile-quick-actions {
      display: grid;
      grid-template-columns: 1.2fr 0.7fr 0.9fr;
      gap: 0.5rem;
      max-width: 100%;
      padding: 0 1rem 1.25rem;
      margin: -0.75rem auto 0.25rem;
    }

    .experience-bar {
      padding: 0 1rem 2rem;
    }

    .featured {
      padding: 1.5rem 1.25rem 2rem;
    }

    .project-card {
      padding: 1.5rem;
    }
  }

  /* ── Latest Writing ── */
  .writing-section {
    max-width: 1080px;
    margin: 0 auto;
    padding: 1rem 2rem 4rem;
  }

  .writing-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 1.75rem;
    gap: 1rem;
  }

  .writing-title {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.3rem;
  }

  .writing-sub {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .writing-all {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-teal);
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.2s ease;
    flex-shrink: 0;
  }

  .writing-all:hover { opacity: 0.75; }

  .writing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .writing-card {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-lg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    text-decoration: none;
    color: inherit;
    transition:
      transform var(--transition),
      border-color var(--transition),
      box-shadow var(--transition),
      background var(--transition);
    position: relative;
    overflow: hidden;
  }

  .writing-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: var(--gradient-hero);
    opacity: 0;
    transition: opacity var(--transition);
  }

  .writing-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-card-hover);
    box-shadow: var(--shadow-card-hover);
  }

  .writing-card:hover::before { opacity: 1; }

  .writing-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .writing-date {
    font-size: 0.7rem;
    color: var(--text-muted);
    font-weight: 500;
    flex-shrink: 0;
  }

  .writing-tags {
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .writing-tag {
    font-size: 0.6rem;
    font-weight: 600;
    padding: 0.15rem 0.45rem;
    background: var(--accent-surface);
    border: 1px solid var(--accent-border);
    border-radius: 100px;
    color: var(--accent-teal);
  }

  .writing-card-title {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    line-height: 1.4;
    flex: 1;
  }

  .writing-card-desc {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .writing-read {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent-teal);
    margin-top: auto;
  }

  @media (max-width: 900px) {
    .writing-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .writing-section {
      padding: 1rem 1.25rem 3rem;
    }

    .writing-grid {
      grid-template-columns: 1fr;
    }

    .writing-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
