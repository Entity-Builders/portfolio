---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import { caseStudies } from '../../data/caseStudies';
---

<Layout
  title="Case Studies - Senior Product Engineer, AI & Mobile Systems"
  description="Senior Product Engineering case studies by Juan Obrach: scale-up mobile work, AI learning systems, B2B workflows, and independent product infrastructure."
  pageType="case_studies_index"
>
  <main class="case-studies-page">
    <section class="case-index-hero" data-analytics-surface="case_studies_hero">
      <div class="case-eyebrow">Senior Product Engineering Case Studies</div>
      <h1>How I turn ambiguous product ideas into shipped systems.</h1>
      <p>
        A focused set of case studies for technical leaders who want to see
        product judgment, architecture decisions, tradeoffs, and real execution
        across mobile, AI, B2B workflows, and independent product systems.
      </p>
      <div class="case-actions">
        <a href="mailto:juanobrach@gmail.com" class="case-action primary">Start a conversation</a>
        <a href="/about" class="case-action">About Juan</a>
      </div>
    </section>

    <section class="case-index-grid" aria-label="Case studies" data-analytics-surface="case_studies_grid">
      {caseStudies.map((study, index) => (
        <CaseStudyCard study={study} featured={index === 0} />
      ))}
    </section>

    <section class="case-index-note">
      <div>
        <span class="case-eyebrow">What to look for</span>
        <h2>Not just what shipped. How the decisions were made.</h2>
      </div>
      <p>
        These are written for Engineering Managers, CTOs, and technical founders:
        the people who need someone comfortable with ambiguity, product context,
        and the unglamorous details that make systems survive contact with users.
      </p>
    </section>

    <Footer />
  </main>
</Layout>

<style>
  .case-studies-page {
    position: relative;
    z-index: 1;
  }

  .case-index-hero,
  .case-index-grid,
  .case-index-note {
    max-width: 1080px;
    margin: 0 auto;
    padding-left: 2rem;
    padding-right: 2rem;
  }

  .case-index-hero {
    padding-top: 5rem;
    padding-bottom: 2rem;
  }

  .case-eyebrow {
    color: var(--accent-teal);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.85rem;
  }

  h1 {
    max-width: 820px;
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: 0.98;
    letter-spacing: -0.05em;
    font-weight: 900;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
    overflow-wrap: break-word;
  }

  .case-index-hero p {
    max-width: 680px;
    color: var(--text-secondary);
    font-size: 1.06rem;
    line-height: 1.75;
  }

  .case-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .case-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.75rem 1.15rem;
    border-radius: 999px;
    color: var(--text-primary);
    border: 1px solid var(--border-card);
    background: var(--surface-muted);
    font-size: 0.86rem;
    font-weight: 800;
    text-decoration: none;
  }

  .case-action.primary {
    border: none;
    color: var(--text-on-accent);
    background: var(--gradient-hero);
  }

  .case-index-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    padding-top: 1.5rem;
    padding-bottom: 2rem;
  }

  .case-index-grid :global(.case-card:first-child) {
    grid-column: span 2;
  }

  .case-index-note {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
    padding-top: 2rem;
    padding-bottom: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .case-index-note h2 {
    color: var(--text-primary);
    font-size: 1.35rem;
    line-height: 1.25;
    letter-spacing: -0.03em;
  }

  .case-index-note p {
    color: var(--text-secondary);
    line-height: 1.75;
    font-size: 0.98rem;
  }

  @media (max-width: 760px) {
    .case-index-grid,
    .case-index-note {
      grid-template-columns: 1fr;
    }

    .case-index-grid :global(.case-card:first-child) {
      grid-column: span 1;
    }
  }

  @media (max-width: 640px) {
    .case-index-hero,
    .case-index-grid,
    .case-index-note {
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }

    .case-index-hero {
      padding-top: 3rem;
    }

    .case-actions {
      flex-direction: column;
    }

    .case-action {
      width: 100%;
    }
  }
</style>
